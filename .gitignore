# Secrets and local config (never commit)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# TheMealDB download cache and import output (not redistributed, spec section 9)
backend/data/cache/
backend/import_report.csv

# Terraform: local state can contain sensitive values, and .terraform/ holds
# downloaded providers (hundreds of MB). The lock file IS committed, so everyone
# and CI resolve the same provider versions.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json

# macOS and editors
.DS_Store
.vscode/
.idea/
