# Copy to .env (git-ignored) for local development: cp .env.example .env
ENV=local
APP_VERSION=local
DATABASE_URL=postgresql+psycopg://scrappy:scrappy@localhost:5433/scrappy
# Local matches production: real tokens, verified against the real pool.
AUTH_MODE=cognito
COGNITO_USER_POOL_ID=us-east-1_BGRZfVyDd
COGNITO_CLIENT_ID=1a4e4cidj9kpdr52ob85fp8em7

# --- AI features (F7, F8). Backend only: never prefix any of these with VITE_.
#
# Leave AI_ENABLED=false and the endpoint answers 503 without needing a key at all. To try
# the feature locally, put a real key in .env (which git ignores) and flip this to true.
# Each call then spends about a cent of real money.
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MONTHLY_BUDGET_CENTS=500
AI_DAILY_SUBSTITUTIONS_PER_USER=10
AI_DAILY_GENERATIONS_PER_USER=3
